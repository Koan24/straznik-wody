generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WaterLevel {
  LOW
  MEDIUM
  HIGH
}

enum AccessLevel {
  EASY
  MEDIUM
  HARD
}

enum ReadCondition {
  GOOD
  LIMITED
  BAD
}

model User {
  id         Int          @id @default(autoincrement())
  imie       String
  email      String       @unique
  password   String
  rola       String       @default("user")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  zgloszenia Zgloszenie[]
  pomiary    Pomiar[]
}

model Wodowskaz {
  id        Int      @id @default(autoincrement())
  nazwa     String
  lat       Float?
  lng       Float?
  opis      String?
  pomiary   Pomiar[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Zgloszenie {
  id                Int      @id @default(autoincrement())
  tytul             String
  opis              String?
  typObiektu        String
  rodzajUszkodzenia String
  stopien           Int
  lat               Float?
  lng               Float?
  status            String   @default("open")
  userId            Int?
  user              User?    @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Pomiar {
  id Int @id @default(autoincrement())

  wodowskazId Int
  wodowskaz   Wodowskaz @relation(fields: [wodowskazId], references: [id])

  wartosc Float

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
